[Unit]
Description=AWG Panel private host adapter
After=network-online.target awg-quick@awg0.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/awg-panel/agent.py --serve
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/awg-panel /etc/amnezia/amneziawg
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
