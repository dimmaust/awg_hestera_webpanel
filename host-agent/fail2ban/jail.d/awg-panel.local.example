# /etc/fail2ban/jail.d/awg-panel.local — СВОИ адреса оператора. staging-файл этапа `fail2ban`.
#
# Почему это отдельный файл: awg-panel.conf пишет install.sh и перезаписывает его при
# каждой установке, а .local fail2ban подхватывает поверх него и никто не трогает.
#
# Почему это обязательно перед первым входом в панель: лестница банов — две неудачные
# попытки за час = 30 минут бана (maxretry = 2 в [DEFAULT]), второй бан за сутки = DROP
# навсегда ([recidive]). Опечатка с домашнего адреса после переустановки узла — и вы
# сидите в бане тридцать минут, а разбан руками — это отдельная операция.
#
# Сюда же ОБЯЗАТЕЛЬНО кладётся адрес самого узла: запросы Hysteria2-авторизации идут
# с 127.0.0.1 и с docker-моста, а запросы узла к своему опубликованному порту — с его
# же внешнего адреса. Их бан = отказ авторизации всех абонентов Hysteria2.
[DEFAULT]
operator_ip = __OPERATOR_IPS__
