# /etc/systemd/system/telemt.service — движок MTProto под управлением панели.
#
# Основа — модуль из QUICK.ru.md и генератора установщика telemt (User/Group=telemt,
# WorkingDirectory=/opt/telemt, capabilities через ambient-набор, без файловых capabilities
# на бинарнике). Добавлено только то, что нужно панели: движок пишет собственный
# telemt.toml через Control API и держит кэш TLS-профилей в WorkingDirectory, поэтому
# ProtectSystem=strict идёт вместе с ReadWritePaths на оба пути.
#
# Перед запуском: useradd -d /opt/telemt -m -r -U telemt && chown -R telemt:telemt /etc/telemt

[Unit]
Description=Telemt MTProto proxy (panel-managed)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=telemt
Group=telemt
WorkingDirectory=/opt/telemt
ExecStart=/bin/telemt /etc/telemt/telemt.toml
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/telemt /opt/telemt

[Install]
WantedBy=multi-user.target
