PANEL_PORT=5000
# 127.0.0.1 keeps the panel reachable only over an SSH tunnel. Use 0.0.0.0 only
# when you have another protection in front of it.
PANEL_BIND=127.0.0.1
ADMIN_LOGIN=admin
# Generate with: openssl rand -base64 24
ADMIN_PASSWORD=replace-with-a-unique-password
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
# Unix socket of awg-panel-agent on the host, bind-mounted read-only.
AGENT_SOCKET=/run/awg-panel/agent.sock
AGENT_TIMEOUT=5
